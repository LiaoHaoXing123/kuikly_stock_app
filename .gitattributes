# Normalize line endings to LF for cross-platform consistency
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.swift text eol=lf
*.m text eol=lf
*.h text eol=lf
*.ts text eol=lf
*.ets text eol=lf
*.cpp text eol=lf

# Treat binary files as-is
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.aar binary
*.jar binary
*.so binary
*.dex binary
*.class binary

*.mp4 binary
