<?xml version="1.0" encoding="utf-8"?>
<!--
  模块切换（底部 Tab 之间、同级目的地）的入场动画：新页面在原页面上淡入。

  210ms + decelerate 来自 Material fade through 的入场段（整段 300ms：出场占前 30%，
  入场占后 70%）。窗口级别的转场不做出场动画——详见 KRRouterAdapter.applyFadeTransition。
  层级下钻（详情页等）不走这个动画，仍然是系统默认的横切。
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/kr_decelerate"
    android:duration="210"
    android:fromAlpha="0.0"
    android:toAlpha="1.0" />
